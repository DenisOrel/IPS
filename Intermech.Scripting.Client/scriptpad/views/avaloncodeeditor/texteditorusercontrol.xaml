<UserControl x:Class="Intermech.Scripting.ScriptPad.Views.AvalonCodeEditor.TextEditorUserControl" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Intermech.Scripting.ScriptPad.Views.AvalonCodeEditor"
             xmlns:ave="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:bcl="http://schemas.intermech.org/bcl/wpf">
  <FrameworkElement.Resources>
    <bcl:BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
  </FrameworkElement.Resources>
  <ave:TextEditor ContextMenuOpening="OnCodeEditorContextMenuOpening"
                  ContextMenuClosing="OnCodeEditorContextMenuClosing" x:Name="CodeEditor" ShowLineNumbers="true"
                  FontFamily="{Binding FontFamily}" FontSize="{Binding FontSize}" Document="{Binding Document}"
                  IsReadOnly="{Binding IsReadOnly}">
    <FrameworkElement.ContextMenu>
      <ContextMenu ItemsSource="{Binding ContextMenu.Items}"
                   Visibility="{Binding ContextMenu.HasItems, Converter={StaticResource BooleanToVisibility}}">
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="{x:Type MenuItem}">
            <Setter Property="HeaderedItemsControl.Header" Value="{Binding Text}"/>
          </Style>
        </ItemsControl.ItemContainerStyle>
      </ContextMenu>
    </FrameworkElement.ContextMenu>
  </ave:TextEditor>
</UserControl>