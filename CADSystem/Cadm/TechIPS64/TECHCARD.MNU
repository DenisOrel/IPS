***POP1
**TECHCRD
             [ТЕХ. ЭСКИЗ]
               [->Па&нели TECHCARD]
                 [Технологический эскиз]^C^C^P_-toolbar;TECHCARD.TB_TECH;_show;^P
                 [Редактировать тех. эскиз]^C^C^P_-toolbar;TECHCARD.TB_EDIT_DRAFT;_show;^P
                 [Граница поля рисунка]^C^C^P_-toolbar;TECHCARD.TB_BLANKBORDER;_show;^P
                 [Установочные элементы]^C^C^P_-toolbar;TECHCARD.TB_SETEL;_show;^P
                 [Копирование эскиза]^C^C^P_toolbar;TECHCARD.TB_COPYDRAFT;_show;^P
                 [<-Содержание операции]^C^C^P_-toolbar;TECHCARD.TB_OPERINFO;_show;^P
[~--]
ID_TCDrafts    [->Эскизы]
ID_TCNewDrf      [Новый...]^C^CNewDraft
ID_TCOpenDrf     [Открыть...]^C^CShowDraft
ID_TCOpenByPt    [Открыть по точке...]^C^CLoadByPnt
ID_TCClrDrft     [<-Очистить]^C^CClearDrafts

               [->Редактировать тех. эскиз]
ID_TCDelDrf      [Удалить...]^C^CDelDraft
ID_TCCopyDrf     [Копировать эскиз...]^C^CCopyOper
                 [~--]
                 [Вырезать в буфер]^C^C_cutentclip
                 [Копировать эскиз в буфер]^C^C_copyoperclip
                 [Копировать в буфер]^C^C_copyentclip
                 [<-Вставить в эскиз]^C^C_pasteoperclip

ID_TCBlExtnt   [->Граница поля рисунка]
ID_TCBlExtAl     [на все эскизы]^C^CMkBorder
ID_TCBlExtOp     [на эскиз]^C^CMkOpBorder
                 [~--]
ID_TCBlExtOn     [включить]^C^CBorderOn
ID_TCBlExtOf     [<-выключить]^C^CBorderOff
ID_NumByPnt    [Номер эскиза по точке]^C^CDNameByPnt
ID_TCOperСnt   [Содержание операции...]^C^COperInfo
ID_TCCOprСnt   [Содержание текущей операции]^C^CCOperInfo
//               [~--]
//ID_DrawTTT     [Тех. требования]^C^CDrawTTT
//ID_EditTTT     [Изменить тех. требования]^C^CEditTTT
               [~--]
               [Обработка поверхности]^C^C_ProcessSurf
               [Отмена обработки поверхности]^C^C_UnProcessSurf
               [Маркер поверхности   ]^C^CSurfMark
               [->Установочные элементы]^C^C^P(if (not c:fix) (load "fix"));fix
                 [опоры,зажимы]^C^C^P(if (not c:fix) (load "fix")) (vsetq 'pr "bs");fix
                 [<-центры,оправки]^C^C^P(if (not c:fix) (load "fix")) (vsetq 'pr "cen");fix
               [~--]
//               [Технологические размеры]^C^P(load "tcmdtxt");(if (not c:cmdim) (load "lisp/cmdim"));cmdim
//               [Редактировать размеры]^C^P(load "tcmdtxt");(if (not c:cmdimw) (load "lisp/cmdimw"));(vsetq 'dtype "NEW");cmdimw
               [Специальное масштабирование]^C^CSpecScale
               [~--]
               [Инструментальная наладка]^C^C^P$i=TECHCARD.ctools $i=*
               [Расчленить в текущий слой]^C^CEXPLAY               
               [~--]
ID_DraftOn     [Эскиз]^C^C_LoadDraft
ID_DrawnOn     [Базовая деталь]^C^C_LoadDrawing
ID_LoadS4Doc   [Загрузить чертеж из SEARCH...]^C^CLoadS4Doc
               [~--]
               [Типовые элементы]^C^C^P(if (null C:cadmgr_list) (load (strcat cadm_pth "lisp/Groupf.lsp")));^Pcadmgr_list
               [~--]
               [->Сервис]
               [Обнуление координаты Z]^C^CZ0
               [<-Поиск объектов за пределами эскиза]^C^CCHB
               [~--]
               [Слайд эскиза]^C^P_MSLIDE
ID_QuitDraft   [Закончить работу с эскизами]^C^C_QUIT;

